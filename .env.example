# MongoDB Atlas configuration for VICTUS / Zyricon
DATABASE_BACKEND=mongodb

# Your MongoDB Data API App ID (from Atlas -> App Services -> Data API)
MONGODB_APP_ID=89ee6624-eb29-46f1-9eb8-7bcfd47acdcb

# Generate in Atlas -> App Services -> your app -> API Keys
MONGODB_API_KEY=your-api-key-here

# Data source name (Atlas -> Data Sources - usually Cluster0)
MONGODB_DATA_SOURCE=Cluster0

# Database name in Atlas
MONGODB_DATABASE=victus

# Optional: direct connection string (preferred if available)
# Atlas -> Connect -> Drivers -> copy mongodb+srv://...
# MONGODB_URI=mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/victus?retryWrites=true&w=majority
